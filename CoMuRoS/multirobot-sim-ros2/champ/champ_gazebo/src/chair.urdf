<?xml version="1.0"?>
<robot name="chair">
  <link name="base_link">
    <visual>
      <geometry>
        <mesh filename="model://chair/meshes/chair.stl" scale="1 1 1"/>
      </geometry>
    </visual>
    <collision>
      <geometry>
        <mesh filename="model://chair/meshes/chair.stl" scale="1 1 1"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="5.0"/>
      <origin xyz="0 0 0" />
      <inertia ixx="0.1" ixy="0.0" ixz="0.0"
               iyy="0.1" iyz="0.0"
               izz="0.1"/>
    </inertial>
  </link>
</robot>

