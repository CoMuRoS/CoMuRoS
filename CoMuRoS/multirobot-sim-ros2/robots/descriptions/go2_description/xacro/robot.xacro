        ixx="0.001" ixy="0.0"  ixz="0.0"
        iyy="0.001" iyz="0.0"
        izz="0.001"/>
    </inertial>
  </link>

  <joint name="first_aid_joint" type="fixed">
    <parent link="holder_link"/>
    <child link="kit_body"/>
    <origin xyz="0 0 .032" rpy="0 -0.1 0"/>
  </joint>

  <gazebo reference="kit_body">
    <material>Gazebo/Red</material>
    <mu1>0.9</mu1>
    <mu2>0.9</mu2>
    <kp>1000000.0</kp>
    <kd>1.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>0.01</maxVel>
  </gazebo>

  <link name="cross_horizontal">
    <visual>
      <origin xyz="0 0 0.026" rpy="0 0 0"/>
      <geometry>
        <box size="0.1 0.02 0.001"/>
      </geometry>
      <material name="White">
        <color rgba="1 1 1 1"/>
      </material>
    </visual>
  </link>

  <link name="cross_vertical">
    <visual>
      <origin xyz="0 0 0.026" rpy="0 0 0"/>
