  </link>

  <joint name="cross_horizontal_joint" type="fixed">
    <parent link="kit_body"/>
    <child link="cross_horizontal"/>
    <origin xyz="0 0 0.002" rpy="0 0 0"/>
  </joint>

  <joint name="cross_vertical_joint" type="fixed">
    <parent link="kit_body"/>
    <child link="cross_vertical"/>
    <origin xyz="0 0 0.002" rpy="0 0 0"/>
  </joint>
   -->

  <!-- modification start -->



